# tg-s3-self — settings for ./deploy.sh (local, Docker, or --vps deploy)
#
# Copy to .env and fill in:   cp .env.example .env
# Never commit .env. Deploying with GitHub Actions instead? Use repository
# Secrets/Variables; this file is not used there (see docs/deployment.md).
#
# Web upload (GET / and POST /api/web-upload) is NOT configured here:
# deploy.sh does not read WEB_UPLOAD_BUCKET from .env. Change it in
# wrangler.toml [vars] (set WEB_UPLOAD_BUCKET = "off" to disable).

# ===== Required =====

# Telegram bot token from @BotFather.
TG_BOT_TOKEN=

# Telegram supergroup where files are stored (looks like -1001234567890).
# The bot must be an administrator of this group.
DEFAULT_CHAT_ID=

# Comma-separated Telegram user IDs allowed to use the bot and the Mini App, e.g. 123456789,987654321.
# Get your ID by messaging @userinfobot. deploy.sh refuses to deploy without it.
TG_ADMIN_IDS=

# ===== Cloudflare credentials =====

# API token: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Workers Scripts:Edit, D1:Edit, Workers R2 Storage:Edit, Account Settings:Read.
# For automatic tunnel creation (CF_CUSTOM_DOMAIN) also: Cloudflare Tunnel:Edit, DNS:Edit.
# Required for the Docker deploy. For a local (non-Docker) deploy you may leave it
# empty; deploy.sh then falls back to `npx wrangler login`.
CLOUDFLARE_API_TOKEN=

# Account ID. Needed if your token can access more than one account.
# The legacy name CF_ACCOUNT_ID is still accepted as an alias.
CLOUDFLARE_ACCOUNT_ID=

# ===== Optional =====

# Custom domain on a Cloudflare zone in the same account, e.g. files.example.com.
# deploy.sh uses it as WORKER_URL and registers the Telegram webhook there, and
# (with CLOUDFLARE_API_TOKEN) creates a Cloudflare Tunnel at vps.<domain> for the
# processor. It does NOT attach the domain to the Worker: add a [[routes]] entry
# with custom_domain = true and set workers_dev = false in wrangler.toml yourself.
# Leave empty to use the *.workers.dev URL.
CF_CUSTOM_DOMAIN=

# Telegram API credentials from https://my.telegram.org (set both or neither).
# Enables the Local Bot API container, needed for files over 20 MB (up to 2 GB)
# together with a processor the Worker can reach (CF_CUSTOM_DOMAIN tunnel, or
# CF_TUNNEL_TOKEN + VPS_URL below).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Processor reachable by the Worker, if you set it up yourself
# (auto-filled when deploy.sh creates the tunnel).
# VPS_URL=https://vps.files.example.com
# Token of a tunnel you created in Cloudflare Zero Trust > Tunnels (auto-filled when created by deploy.sh).
# CF_TUNNEL_TOKEN=

# Only for `./deploy.sh --vps` (deploy the processor over SSH, no local Docker):
# VPS_SSH=user@your-server
# VPS_DEPLOY_DIR=/opt/tg-s3-self
# VPS_PORT=3000

# ===== Auto-generated by deploy.sh =====
# Left empty, these are generated or detected on the first run and written back to this file.
# VPS_SECRET=        Shared secret between the Worker and the processor
# SSE_MASTER_KEY=    Key for server-side encryption (SSE-S3). Keep it unchanged once
#                    encrypted objects exist; they cannot be read without it.
# D1_DATABASE_ID=    ID of the tg-s3-self-db D1 database
# TG_LOCAL_API=      Bot API endpoint used by the processor (set from TELEGRAM_API_ID/HASH)
